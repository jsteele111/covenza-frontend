Set-Content -Path .gitignore -Encoding utf8 -Value @"
node_modules
dist
dist-ssr
*.local
.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local Netlify folder
.netlify
test-wallet-*.json

# Netlify CLI's Deno lockfile (Edge Functions tooling, auto-generated)
deno.lock
"@