# Copy this file to .env and fill in your own values.
#
# NOTE ON VITE_ VARIABLES: anything prefixed VITE_ is compiled into the
# client bundle at build time and is publicly readable by anyone who
# views the site. These are configuration, not secrets. Never put a
# private key or anything sensitive behind a VITE_ prefix.

# --- Client-side (public) ---------------------------------------------

# Get a free project ID at https://cloud.reown.com
# Required: RainbowKit refuses to start without one, even if only the
# MetaMask browser extension is used.
VITE_WALLETCONNECT_PROJECT_ID=

# Your Robinhood Chain testnet RPC URL — this is now the app's default
# network. Alchemy supports it (robinhood-testnet.g.alchemy.com/v2/{KEY}).
#
# Worth setting rather than relying on the fallback: the public endpoint
# (rpc.testnet.chain.robinhood.com) drops long-lived connections, which
# surfaced as repeated header timeouts during backend scripting.
#
# Same domain-restriction advice as above — this reaches the public bundle.
VITE_ROBINHOOD_TESTNET_RPC_URL=

# --- Development only ---------------------------------------------------

# Local mock attester (covenza-backend: scripts/mock-verify-server.js), for
# exercising the borrower and lender gates against a local node. Read only by
# `npm run dev`: KycGate ignores it in a production build whatever it is set
# to, so it can never reach covenza.xyz. Leave blank otherwise.
# VITE_VERIFIER_SERVICE_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Removed 4 August 2026
#
# VERIFIER_PRIVATE_KEY is gone. Covenza runs no signing service: a wallet
# obtains an attestation from a recognised provider and presents it.
#
# VITE_ARBITRUM_SEPOLIA_RPC_URL is gone. Covenza targets Robinhood Chain only.
# ---------------------------------------------------------------------------
