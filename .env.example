# Copy this file to .env and fill in your own values.
#
# NOTE ON VITE_ VARIABLES: anything prefixed VITE_ is compiled into the
# client bundle at build time and is publicly readable by anyone who
# views the site. These are configuration, not secrets. Never put a
# private key or anything sensitive behind a VITE_ prefix.


# --- Client-side (public) ---------------------------------------------

# Get a free project ID at https://cloud.reown.com
# Required for WalletConnect / mobile wallets in the connect button.
# The MetaMask browser extension works even without this.
VITE_WALLETCONNECT_PROJECT_ID=

# Your Alchemy (or other provider) Arbitrum Sepolia RPC URL.
# Leave blank to fall back to a public RPC — fine for local development,
# but public endpoints rate-limit quickly under the dashboard's parallel
# reads, so set this for any deployed environment.
#
# Because this ends up in the public bundle, use a key that is
# domain-restricted in your provider's dashboard rather than sharing one
# with backend deployment scripts.
VITE_ARBITRUM_SEPOLIA_RPC_URL=

# Base URL the KYC verifier is reached at. KycGate.jsx requests
# `${VITE_VERIFIER_SERVICE_URL}/verify`.
#
#   local dev  -> http://localhost:4000   (scripts/mock-verify-server.js
#                                          in the backend repo)
#   Netlify    -> /.netlify/functions     (serves netlify/functions/verify.js)
#
# Defaults to http://localhost:4000 if unset.
VITE_VERIFIER_SERVICE_URL=


# --- Server-side (secret) ---------------------------------------------
# Used only by netlify/functions/verify.js, which runs server-side. Set
# this in your host's environment variable settings (Netlify: Site
# configuration -> Environment variables), NOT in a committed file.
#
# Deliberately no VITE_ prefix — that would expose it in the client
# bundle. This key signs KYC attestations; anyone holding it can mint
# verifications against the registry.

VERIFIER_PRIVATE_KEY=