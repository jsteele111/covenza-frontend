# Copy this file to .env and fill in your own values.

# Get a free project ID at https://cloud.reown.com
# (Required for WalletConnect/mobile wallets in the connect button.
# MetaMask browser extension works even without this.)
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: your Alchemy Arbitrum Sepolia RPC URL, same one from your
# backend's .env. Leave blank to use a public fallback RPC instead.
VITE_ARBITRUM_SEPOLIA_RPC_URL=
